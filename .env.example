# ========================
# Vanadrishti Backend Environment Variables (Example)
# ========================
# Copy this file to .env and fill in your values
# DO NOT COMMIT REAL VALUES

# ----- Supabase -----
# Supabase project URL (Required for database and auth)
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Anon Key (Required for client access)
SUPABASE_ANON_KEY=your_supabase_anon_key

# ----- Gemini AI -----
# Gemini API Key for AI health verifications
# Kept strictly backend-only. Never expose to frontend.
GEMINI_API_KEY=your_gemini_api_key

# ----- Telegram Notifications (Optional) -----
# Backend-only notification service for alerts.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ----- Earth Engine -----
# Note: Earth Engine configuration uses service account JSON.
# Do NOT commit your service account JSON. Add its path or credentials here.
# (Currently authenticated via local google cloud environment or explicit path)
