# ========================
# Vanadrishti Frontend Environment Variables (Example)
# ========================
# Copy this file to .env.local and fill in your values
# DO NOT COMMIT REAL VALUES

# ----- API Endpoint -----
# The URL where the FastAPI backend is running
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----- Supabase -----
# Supabase URL and Anon Key are required for client-side Auth and minimal direct queries
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ----- Mapbox (Optional) -----
# Mapbox token if used for custom tiles (currently Esri is default)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
